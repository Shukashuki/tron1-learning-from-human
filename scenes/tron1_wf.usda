#usda 1.0
(
    customLayerData = {
        bool inspection_fixture = 1
        string purpose = "Model import and articulation smoke test; no locomotion policy"
        string robot = "LimX TRON1 WF"
    }
    defaultPrim = "World"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    timeCodesPerSecond = 120
    upAxis = "Z"
)

def Xform "World"
{
    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }

    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.18, 0.21, 0.25)]
        double size = 1
        float3 xformOp:scale = (6, 6, 0.1)
        double3 xformOp:translate = (0, 0, -0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Xform "TRON1" (
        prepend references = @../assets/robots/WF_TRON1A/WF_TRON1A.usd@
    )
    {
        double3 xformOp:translate = (0, 0, 0.966)

        over "joints"
        {
            over "abad_L_Joint" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            )
            {
                float drive:angular:physics:damping = 0.04363323
                float drive:angular:physics:maxForce = 80
                float drive:angular:physics:stiffness = 0.6981317
                float drive:angular:physics:targetPosition = 0
                float drive:angular:physics:targetVelocity = 0
                uniform token drive:angular:physics:type = "force"
            }

            over "hip_L_Joint" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            )
            {
                float drive:angular:physics:damping = 0.04363323
                float drive:angular:physics:maxForce = 80
                float drive:angular:physics:stiffness = 0.6981317
                float drive:angular:physics:targetPosition = 0
                float drive:angular:physics:targetVelocity = 0
                uniform token drive:angular:physics:type = "force"
            }

            over "knee_L_Joint" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            )
            {
                float drive:angular:physics:damping = 0.04363323
                float drive:angular:physics:maxForce = 80
                float drive:angular:physics:stiffness = 0.6981317
                float drive:angular:physics:targetPosition = 0
                float drive:angular:physics:targetVelocity = 0
                uniform token drive:angular:physics:type = "force"
            }

            over "wheel_L_Joint" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            )
            {
                float drive:angular:physics:damping = 0.013962634
                float drive:angular:physics:maxForce = 80
                float drive:angular:physics:stiffness = 0
                float drive:angular:physics:targetPosition = 0
                float drive:angular:physics:targetVelocity = 0
                uniform token drive:angular:physics:type = "force"
            }

            over "abad_R_Joint" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            )
            {
                float drive:angular:physics:damping = 0.04363323
                float drive:angular:physics:maxForce = 80
                float drive:angular:physics:stiffness = 0.6981317
                float drive:angular:physics:targetPosition = 0
                float drive:angular:physics:targetVelocity = 0
                uniform token drive:angular:physics:type = "force"
            }

            over "hip_R_Joint" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            )
            {
                float drive:angular:physics:damping = 0.04363323
                float drive:angular:physics:maxForce = 80
                float drive:angular:physics:stiffness = 0.6981317
                float drive:angular:physics:targetPosition = 0
                float drive:angular:physics:targetVelocity = 0
                uniform token drive:angular:physics:type = "force"
            }

            over "knee_R_Joint" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            )
            {
                float drive:angular:physics:damping = 0.04363323
                float drive:angular:physics:maxForce = 80
                float drive:angular:physics:stiffness = 0.6981317
                float drive:angular:physics:targetPosition = 0
                float drive:angular:physics:targetVelocity = 0
                uniform token drive:angular:physics:type = "force"
            }

            over "wheel_R_Joint" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            )
            {
                float drive:angular:physics:damping = 0.013962634
                float drive:angular:physics:maxForce = 80
                float drive:angular:physics:stiffness = 0
                float drive:angular:physics:targetPosition = 0
                float drive:angular:physics:targetVelocity = 0
                uniform token drive:angular:physics:type = "force"
            }

            def PhysicsFixedJoint "inspection_fixture"
            {
                rel physics:body1 = </World/TRON1/base_Link>
                point3f physics:localPos0 = (0, 0, 0.966)
                point3f physics:localPos1 = (0, 0, 0)
            }
        }
    }

    def DomeLight "Light"
    {
        float inputs:intensity = 900
    }

    def Camera "Camera"
    {
        float2 clippingRange = (0.01, 100)
        float focalLength = 32
        matrix4d xformOp:transform = ( (-0.7071067811865477, 0.7071067811865477, 0, 0), (-0.22691230911700366, -0.22691230911700366, 0.9471122467492327, 0), (0.669709492221209, 0.669709492221209, 0.3209024650226627, -0), (2.4, 2.4, 1.7, 1) )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }
}
